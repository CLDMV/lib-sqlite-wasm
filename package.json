{
	"name": "@cldmv/sqlite-wasm",
	"version": "0.0.1",
	"description": "SQLite compiled to WebAssembly for Node.js and browsers, with file storage on disk and in OPFS",
	"type": "module",
	"license": "Apache-2.0",
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./types/src/index.d.mts",
	"files": [
		"dist/",
		"!dist/**/*.map",
		"types/"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/lib-sqlite-wasm.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/lib-sqlite-wasm/issues"
	},
	"homepage": "https://github.com/CLDMV/lib-sqlite-wasm#readme",
	"keywords": [
		"sqlite",
		"wasm",
		"webassembly",
		"opfs",
		"drizzle"
	],
	"exports": {
		".": {
			"sqlite-wasm-dev": {
				"types": "./src/index.mts",
				"import": "./src/index.mts"
			},
			"types": "./types/src/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./host": {
			"sqlite-wasm-dev": {
				"types": "./src/worker/host.mts",
				"import": "./src/worker/host.mts"
			},
			"types": "./types/src/worker/host.d.mts",
			"import": "./dist/host.mjs"
		},
		"./worker": {
			"sqlite-wasm-dev": {
				"types": "./src/worker/client.mts",
				"import": "./src/worker/client.mts"
			},
			"types": "./types/src/worker/client.d.mts",
			"import": "./dist/worker.mjs"
		},
		"./drizzle": {
			"sqlite-wasm-dev": {
				"types": "./src/drizzle.mts",
				"import": "./src/drizzle.mts"
			},
			"types": "./types/src/drizzle.d.mts",
			"import": "./dist/drizzle.mjs",
			"require": "./dist/drizzle.cjs"
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.22.0",
			"onFail": "error"
		}
	},
	"peerDependencies": {
		"drizzle-orm": "^0.45.0"
	},
	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		}
	},
	"scripts": {
		"build": "tsup && npm run build:wasm",
		"build:wasm": "node scripts/build-wasm.mjs",
		"build:ci": "npm run lint && npm run format:check && npm run types:check && npm run types:build && npm run build",
		"sqlite:bump": "node scripts/bump-sqlite.mjs",
		"prepack": "npm run build",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\"",
		"types:build": "tsc -p .configs/tsconfig.json --noCheck",
		"types:check": "tsc -p .configs/tsconfig.json --noEmit",
		"pretest": "npm run build",
		"test": "node tests/run-vitest.mjs && npm run test:cjs && npm run test:dist",
		"test:cjs": "npm run build && node --test tests/cjs/entry.test.cjs tests/cjs/drizzle.test.cjs",
		"test:dist": "npm run build && node tests/run-vitest.mjs --mode=dist",
		"test:browser": "playwright install chromium-headless-shell && vitest run --config .configs/vitest.browser.config.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"precoverage": "npm run build",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage && npm run test:cjs && npm run test:dist",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"fix:headers": "fix-headers --config .configs/fix-headers.json",
		"drizzle:generate": "drizzle-kit generate --config tests/drizzle/fixtures/drizzle.config.mjs"
	},
	"overrides": {
		"katex": ">=0.19.1 <1.0.0",
		"minimatch": "^11.0.3"
	},
	"devDependencies": {
		"@cldmv/configs": "^1.4.0",
		"@cldmv/eslint-plugin-jsonv": "^1.1.2",
		"@cldmv/fix-headers": "^2.3.0",
		"@cldmv/jsonv": "^1.2.2",
		"@cldmv/prettier-plugin-jsonv": "^1.2.2",
		"@cldmv/vitest-runner": "^1.9.0",
		"@eslint/css": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@eslint/markdown": "^9.0.0",
		"@types/node": "^26.6.10",
		"@vitest/browser-playwright": "^5.1.1",
		"@vitest/coverage-v8": "^5.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vitest": "^5.1.1"
	}
}
